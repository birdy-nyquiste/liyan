.DS_Store
.env
.env.production
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]

node_modules/
apps/web/dist/
apps/extension/dist/
apps/extension/liyan-extension.zip
apps/web/*.tsbuildinfo
apps/extension/*.tsbuildinfo

.coverage
htmlcov/

# Celery beat's own record of when each schedule last fired. Runtime state
# belonging to one machine, not to the project.
celerybeat-schedule*

# The signed-in session the browser suite bootstraps once per run. A real
# Supabase access token: never committed, and stale within the hour anyway.
apps/web/e2e/.auth/

# What a browser-test run leaves behind: traces, screenshots, and the HTML
# report. Evidence about one run on one machine, not about the project.
apps/web/test-results/
apps/web/playwright-report/

# Where Playwright's browsers land when installed into the project, which is
# how they survive from a Render build into the running service.
.playwright/

# A design tool's own working notes: scored against one revision of one file,
# addressed to the absolute path it was run from. Like a test run's traces,
# this is a record of one pass on one machine and not of the project.
.impeccable/

# Local overrides, which is where a real key ends up on a real machine.
# `.env.e2e` and `.env.example` are committed on purpose and say so; anything
# a developer writes for themselves is theirs and must not be committable by
# a stray `git add -A`.
.env.local
.env.*.local
