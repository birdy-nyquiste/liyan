{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  // The build tooling and its tests. They live beside `vite.config.ts` rather
  // than in `src` because that is what they are: the manifest and the
  // addresses it carries are decided while building, not while running.
  "include": ["vite.config.ts", "manifest.ts", "releaseTarget.ts", "*.test.ts"]
}
