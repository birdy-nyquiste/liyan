    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.3",
    "@tiptap/core": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
