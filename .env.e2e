# The workbench configuration the Playwright suite's local run is built with.
#
# Committed on purpose: none of it is a secret, and the alternative is a suite
# that passes or fails depending on what a developer happens to have in `.env`.
# `--mode e2e` makes these win over `.env` for that one run and nothing else.
#
# The API is `scripts/e2e_server.py`: the real application, on a disposable
# database, with identity and the paid providers substituted.
VITE_API_BASE_URL=http://localhost:8099

# A Supabase project that cannot exist. The local run never calls Supabase — it
# writes the session Supabase would have written — and a hostname that resolves
# nowhere means a bug in that seeding fails loudly instead of quietly reaching a
# real project. `e2e/support/workbench.ts` derives the storage key from this.
VITE_SUPABASE_URL=https://liyan-e2e.supabase.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=liyan-e2e-publishable-key

# Nothing is reported from a test run.
VITE_SENTRY_DSN=
