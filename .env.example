# 立言阁 local configuration.
#
# LIYAN_* is read by the server and the Celery worker at startup.
# VITE_*  is compiled into the browser bundle by Vite at dev-server start.
#
# Restart the process that reads a value after changing it; Vite values are
# baked in at boot, so the workbench keeps the old ones until it restarts.
# Never put a secret behind a VITE_ name: every browser receives it.

# --- Infrastructure ---

LIYAN_DATABASE_URL=postgresql+psycopg://liyan:liyan@localhost:5432/liyan
# Redis, for the source-processing queue.
LIYAN_BROKER_URL=redis://localhost:6379/0

# --- Authentication and access control ---

# Comma-separated allowlist, matched case-insensitively against the
# verified token's email. Server-only: the browser never learns it.
LIYAN_ALLOWED_EMAILS=writer@example.com
# The Supabase project URL plus /auth/v1. Must equal the token's iss
# exactly, and it also derives the JWKS URL below.
LIYAN_SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
# Override only. Empty resolves to <issuer>/.well-known/jwks.json.
LIYAN_SUPABASE_JWKS_URL=
# Rarely changed; Supabase issues this audience by default.
# LIYAN_SUPABASE_AUDIENCE=authenticated
# Comma-separated browser origins allowed to call the API.
LIYAN_CORS_ORIGINS=http://localhost:5173

# --- Source intake: URL extraction ---

LIYAN_CRAWL4AI_BASE_DIRECTORY=/tmp/liyan-crawl4ai
LIYAN_URL_FETCH_TIMEOUT_SECONDS=60

# --- Source intake: uploaded file storage (Cloudflare R2) ---

LIYAN_R2_ENDPOINT_URL=https://replace-me.r2.cloudflarestorage.com
LIYAN_R2_ACCESS_KEY_ID=
LIYAN_R2_SECRET_ACCESS_KEY=
LIYAN_R2_BUCKET=liyan-local

# --- Source intake: file parsing limits ---

LIYAN_FILE_MAX_BYTES=10485760
LIYAN_FILE_MAX_PAGES=100
LIYAN_FILE_MAX_NORMALIZED_CHARACTERS=500000
LIYAN_FILE_PARSE_TIMEOUT_SECONDS=60
# Zip-bomb guards for DOCX archives.
LIYAN_FILE_MAX_DOCX_ENTRIES=2000
LIYAN_FILE_MAX_DOCX_UNCOMPRESSED_BYTES=52428800

# --- Source preparation ---

# Below this length a source is flagged as short before confirmation.
# LIYAN_SHORT_SOURCE_CHARACTERS=500

# --- 知言 and 立言 runs (DeepSeek) ---

# Required before any report or article can be produced. Without it a run
# fails immediately with provider_unconfigured; the rest of the workbench
# still works. Never expose this to the browser.
LIYAN_DEEPSEEK_API_KEY=
LIYAN_DEEPSEEK_BASE_URL=https://api.deepseek.com
LIYAN_ZHIYAN_MODEL=deepseek-v4-flash
LIYAN_ZHIYAN_TIMEOUT_SECONDS=300
# Defaults shown; 立言 generation uses these.
# LIYAN_LIYAN_MODEL=deepseek-v4-flash
# LIYAN_LIYAN_TIMEOUT_SECONDS=300

# --- Publication: LSForum Blog Preview targets ---

# 发布目标 are server configuration, never user data: the workbench offers no
# way to add, bind, or authorize one. Leave this empty and publishing is simply
# unavailable.
#
# `authors` is the 作者映射: each address is a user allowed to publish there,
# and its value is the author name Blog displays for them. The mapping is the
# authorization, so one Blog can serve several writers under their own names.
# `api_base_url` and `site_url` exclude the /api/v1 path; blog.lsforum.org is
# not resolving yet, so the Vercel hostname is the one that answers today.
LIYAN_PUBLICATION_TARGETS=[{"key":"lsforum","display_name":"LSForum Blog","site_url":"https://blog-lsforum.vercel.app","api_base_url":"https://blog-lsforum.vercel.app","authors":{"writer@example.com":"Zeng Zong"}}]
# The Blog v0.11 ingest credential, sent as a bearer token. Server-only, and
# never returned with a target. Staging must not hold the production value.
# This is the same secret LSForum issues as INGEST_API_KEY.
LIYAN_BLOG_INGEST_TOKEN=
LIYAN_BLOG_TIMEOUT_SECONDS=60

# --- Browser bundle: public by definition ---

VITE_API_BASE_URL=http://localhost:8000
# The project URL, with no /auth/v1 suffix.
VITE_SUPABASE_URL=https://your-project.supabase.co
# The sb_publishable_ key, safe to ship. Never the sb_secret_ key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
