.DS_Store
.env
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]

node_modules/
apps/web/dist/
apps/web/*.tsbuildinfo

.coverage
htmlcov/

# Celery beat's own record of when each schedule last fired. Runtime state
# belonging to one machine, not to the project.
celerybeat-schedule*

# The signed-in session the browser suite bootstraps once per run. A real
# Supabase access token: never committed, and stale within the hour anyway.
apps/web/e2e/.auth/

# What a browser-test run leaves behind: traces, screenshots, and the HTML
# report. Evidence about one run on one machine, not about the project.
apps/web/test-results/
apps/web/playwright-report/

# Where Playwright's browsers land when installed into the project, which is
# how they survive from a Render build into the running service.
.playwright/
